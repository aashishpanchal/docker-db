# -----------------------------
# Stage 1: Build / Fetch Artifacts
# -----------------------------
FROM debian:bookworm-slim AS builder

ARG ARCH=amd64
ARG PG_VERSION=17
ARG ULID_VERSION=0.2.0

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg \
        libpq5 && \
    curl -L -o /tmp/pgx_ulid.deb \
      https://github.com/pksunkara/pgx_ulid/releases/download/v${ULID_VERSION}/pgx_ulid-v${ULID_VERSION}-pg${PG_VERSION}-${ARCH}-linux-gnu.deb && \
    apt-get install -y --no-install-recommends /tmp/pgx_ulid.deb && \
    rm /tmp/pgx_ulid.deb && \
    apt-get purge -y curl && \
    rm -rf /var/lib/apt/lists/*

# -----------------------------
# Stage 2: Final Postgres Image
# -----------------------------
FROM postgres:17-bookworm

ARG PG_VERSION=17
ARG ULID_VERSION=0.2.0

# Copy only required files from builder stage
COPY --from=builder /var/lib/postgresql/extension/ulid.control \
    /usr/share/postgresql/${PG_VERSION}/extension/pgx_ulid.control

COPY --from=builder /var/lib/postgresql/extension/ulid--${ULID_VERSION}.sql \
    /usr/share/postgresql/${PG_VERSION}/extension/pgx_ulid--${ULID_VERSION}.sql

COPY --from=builder /usr/lib/postgresql/lib/pgx_ulid.so \
    /usr/lib/postgresql/${PG_VERSION}/lib/

# Set the shared_preload_libraries parameter
RUN echo "shared_preload_libraries = 'pgx_ulid'" >> /usr/share/postgresql/postgresql.conf.sample
